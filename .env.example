# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# --- Telegram Mini App (optional) --------------------------------------------
# Port ConClaw serves the app on. Unset means no listening socket at all.
MINIAPP_PORT=
# Comma-separated Telegram numeric user ids allowed to open it. This is the
# only thing keeping the app yours: it is served over the public internet, and
# every Telegram user gets a validly signed initData for their own account, so
# the signature proves the request came from Telegram — not that it came from
# you. Empty means ConClaw refuses to start the server.
MINIAPP_ALLOWED_USER_IDS=

# --- Voice transcription (optional) ------------------------------------------
# whisper.cpp on the host. All three must resolve from the *service's* PATH,
# which is not your shell's — prefer absolute paths.
WHISPER_BIN=
WHISPER_MODEL=
FFMPEG_BIN=
